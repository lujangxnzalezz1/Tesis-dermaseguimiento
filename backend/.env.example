# Copiar a `.env` y completar. El archivo `.env` NO se sube a git.

# --- Obligatorios ---
DATABASE_URL=postgresql://USUARIO:CLAVE@localhost:5432/dermaseguimiento
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Sesiones ---
ACCESS_TOKEN_EXPIRE_MINUTES=480
INACTIVITY_TIMEOUT_MINUTES=30

# --- Política de contraseñas ---
PASSWORD_MIN_LENGTH=10
PASSWORD_REQUIRE_UPPER=true
PASSWORD_REQUIRE_LOWER=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_MAX_AGE_DAYS=0

# --- Protección contra abuso ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
# Límite de frecuencia: base (sirve con varios procesos) | memoria
RATE_LIMIT_BACKEND=base
# Proxies inversos de confianza (IPs o CIDR, separados por coma). Solo desde ellos se lee X-Forwarded-For.
# Ejemplo detrás de nginx en la misma máquina: TRUSTED_PROXIES=127.0.0.1
TRUSTED_PROXIES=

# --- CAPTCHA (vacío = desactivado). Proveedor: turnstile | hcaptcha | recaptcha ---
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SECRET=
CAPTCHA_SITE_KEY=
# CAPTCHA_VERIFY_URL=          # opcional: por defecto la URL oficial del proveedor
# CAPTCHA_PUNTAJE_MINIMO=0.5   # solo reCAPTCHA v3
# La app nativa no muestra CAPTCHA (no tiene react-native-webview). true = aceptar sin CAPTCHA las
# solicitudes con la cabecera X-Cliente: app-nativa (falsificable; quedan el límite de frecuencia y el bloqueo).
CAPTCHA_EXIMIR_APP_NATIVA=false

# --- Privacidad (obligatorios en producción) ---
POLITICA_VERSION=1.0
# Correo donde los titulares ejercen sus derechos (acceso, corrección, eliminación)
CONTACTO_PRIVACIDAD=
RETENCION_DATOS_ANIOS=5

# --- Archivos ---
MAX_UPLOAD_MB=10

# --- Suscripciones y pagos ---
ENFORCE_SUBSCRIPTION=true
TRIAL_DAYS=14
AVISOS_DIAS_ANTES=7,3,1
PASARELA=sandbox
PASARELA_WEBHOOK_SECRET=
# Pasarela real (opcional): PASARELA=adamspay y la apikey de tu aplicación de AdamsPay
# PASARELA=adamspay
ADAMSPAY_API_URL=https://staging.adamspay.com/api/v1
ADAMSPAY_API_KEY=
BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Datos del emisor que figuran en los comprobantes
EMISOR_NOMBRE=DermaSeguimiento
EMISOR_RUC=
EMISOR_EMAIL=

# --- Pagos y planes ---
ADAMSPAY_TIMEOUT_SEGUNDOS=15
ADAMSPAY_VIGENCIA_HORAS=24
# EMISOR_LOGO_RUTA=/ruta/al/logo.png   # logo del recibo (opcional)
COMPROBANTE_ENLACE_MINUTOS=5

# Límites de listados y exportaciones
MAX_PLANTILLAS=50
MAX_FILAS_CSV=20000

# --- Correo (opcional: sin SMTP el correo se imprime en la consola del servidor, con los tokens enmascarados) ---
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@dermaseguimiento.local
SMTP_FROM_NAME=DermaSeguimiento

# --- Notificaciones push (opcional: OneSignal > Settings > Keys & IDs) ---
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# --- Datos iniciales (python -m scripts.seed) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
