# Copiar a `.env` y completar. El archivo `.env` NO se sube a git.

# --- Obligatorios ---
DATABASE_URL=postgresql://USUARIO:CLAVE@localhost:5432/dermaseguimiento
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Sesiones ---
ACCESS_TOKEN_EXPIRE_MINUTES=480
INACTIVITY_TIMEOUT_MINUTES=30

# --- Política de contraseñas ---
PASSWORD_MIN_LENGTH=10
PASSWORD_REQUIRE_UPPER=true
PASSWORD_REQUIRE_LOWER=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_MAX_AGE_DAYS=0

# --- Protección contra abuso ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
# CAPTCHA_SECRET=   # clave secreta de reCAPTCHA/Turnstile; vacío = desactivado

# --- Archivos ---
MAX_UPLOAD_MB=10

# --- Suscripciones y pagos ---
ENFORCE_SUBSCRIPTION=true
TRIAL_DAYS=14
AVISOS_DIAS_ANTES=7,3,1
PASARELA=sandbox
PASARELA_WEBHOOK_SECRET=
# Pasarela real (opcional): PASARELA=adamspay y la apikey de tu aplicación de AdamsPay
# PASARELA=adamspay
ADAMSPAY_API_URL=https://staging.adamspay.com/api/v1
ADAMSPAY_API_KEY=
BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# --- pagos y planes (wa) ---
ADAMSPAY_TIMEOUT_SEGUNDOS=15
ADAMSPAY_VIGENCIA_HORAS=24
# EMISOR_LOGO_RUTA=/ruta/al/logo.png   # logo del recibo (opcional)
COMPROBANTE_ENLACE_MINUTOS=5
# --- fin pagos y planes (wa) ---

# --- Correo (opcional: sin SMTP el enlace de recuperación se imprime en la consola del servidor) ---
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@dermaseguimiento.local
SMTP_FROM_NAME=DermaSeguimiento

# --- Notificaciones push (opcional: OneSignal > Settings > Keys & IDs) ---
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# --- Datos iniciales (python -m scripts.seed) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
